root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,sln,xaml,yml,yaml,json,md,html,css,js}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true

[*.sln]
end_of_line = crlf
