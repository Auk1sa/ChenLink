<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ChenLink.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ChenLink.Core">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <core:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <core:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <core:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
