<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChenLink.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ChenLink.Views"
    Title="ChenLink">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 自绘标题栏（可拖动；系统三键交由 Windows 绘制，保留 Snap 布局） ============ -->
        <Grid x:Name="TitleDragRegion" Padding="14,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource BrandGradientBrush}">
                    <FontIcon Glyph="&#xE71B;" FontSize="12" Foreground="White" />
                </Border>
                <TextBlock Text="ChenLink" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Style="{StaticResource PillStyle}" Padding="9,2" Background="{ThemeResource CardBackgroundBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse Fill="{ThemeResource StatusIdleBrush}"
                                     Visibility="{Binding Connect.Status.IsIdle, Converter={StaticResource BoolToVisibility}}" />
                            <Ellipse Fill="{ThemeResource StatusInfoBrush}"
                                     Visibility="{Binding Connect.Status.IsInfo, Converter={StaticResource BoolToVisibility}}" />
                            <Ellipse Fill="{ThemeResource StatusSuccessBrush}"
                                     Visibility="{Binding Connect.Status.IsSuccess, Converter={StaticResource BoolToVisibility}}" />
                            <Ellipse Fill="{ThemeResource StatusWarningBrush}"
                                     Visibility="{Binding Connect.Status.IsWarning, Converter={StaticResource BoolToVisibility}}" />
                            <Ellipse Fill="{ThemeResource StatusDangerBrush}"
                                     Visibility="{Binding Connect.Status.IsDanger, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <TextBlock Text="{Binding TitleStatusText}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 右侧留给系统最小化/最大化/关闭按钮 -->
            <Border x:Name="TitleBarInset" Grid.Column="2" />
        </Grid>

        <!-- ============ 导航 + 页面 ============ -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            OpenPaneLength="212"
            CompactPaneLength="48"
            SelectionChanged="Nav_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="连接" Tag="0">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="诊断" Tag="1">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="2">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <views:ConnectPage Visibility="{Binding IsConnectPage, Converter={StaticResource BoolToVisibility}}" />
                <views:DiagnosticsPage Visibility="{Binding IsDiagnosticsPage, Converter={StaticResource BoolToVisibility}}" />
                <views:SettingsPage Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
