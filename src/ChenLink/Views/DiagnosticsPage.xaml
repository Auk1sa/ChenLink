<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ChenLink.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="RootLayout" HorizontalAlignment="Stretch" Padding="{StaticResource PagePadding}">
            <StackPanel Spacing="18">

                <StackPanel>
                    <TextBlock Text="诊断" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="链路状态、流量与完整日志。遇到连不上时，先看这里，再复制诊断信息给开发者。" />
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 当前会话 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="当前会话" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />

                            <Grid ColumnSpacing="14" Padding="0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="状态" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Diagnostics.Connection.Status.Title}" FontSize="13" TextWrapping="Wrap" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid ColumnSpacing="14" Padding="0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="链路" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Diagnostics.Connection.Status.Mode}" FontSize="13" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid ColumnSpacing="14" Padding="0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="延迟" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Diagnostics.Connection.Status.Latency}" FontSize="13" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid ColumnSpacing="14" Padding="0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="流量" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="↑" FontSize="13" Foreground="{ThemeResource StatusSuccessBrush}" />
                                    <TextBlock Text="{Binding Diagnostics.Connection.Status.Up}" FontSize="13" />
                                    <TextBlock Text="  ↓" FontSize="13" Foreground="{ThemeResource StatusInfoBrush}" />
                                    <TextBlock Text="{Binding Diagnostics.Connection.Status.Down}" FontSize="13" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid ColumnSpacing="14" Padding="0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="下一步" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding Diagnostics.Connection.Status.NextStep}" FontSize="13" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 运行环境 -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="运行环境" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />

                            <StackPanel Spacing="3" Padding="0,7">
                                <TextBlock Text="本机局域网 IP" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Diagnostics.LocalIpText}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Style="{StaticResource DividerStyle}" />

                            <StackPanel Spacing="3" Padding="0,7">
                                <TextBlock Text="权限" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Diagnostics.AdminText}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Style="{StaticResource DividerStyle}" />

                            <StackPanel Spacing="5" Padding="0,7">
                                <TextBlock Text="日志目录" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Diagnostics.LogPath}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Button Content="打开目录" HorizontalAlignment="Left"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Command="{Binding Diagnostics.OpenFolderCommand}" />
                            </StackPanel>
                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid ColumnSpacing="12" Padding="0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Diagnostics.VersionText}" FontSize="13" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="复制诊断信息"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Command="{Binding Diagnostics.CopyDiagnosticsCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 日志 -->
                <Border Style="{StaticResource CardStyle}" Padding="20,18">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="日志" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ToggleButton Grid.Column="1" Content="全部" Style="{StaticResource ChipToggleStyle}"
                                          IsChecked="{Binding ShowAll, Mode=TwoWay}" />
                            <ToggleButton Grid.Column="2" Content="警告" Style="{StaticResource ChipToggleStyle}"
                                          IsChecked="{Binding ShowWarning, Mode=TwoWay}" />
                            <ToggleButton Grid.Column="3" Content="错误" Style="{StaticResource ChipToggleStyle}"
                                          IsChecked="{Binding ShowError, Mode=TwoWay}" />
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                                <Button Content="复制" Style="{StaticResource SubtleButtonStyle}"
                                        Command="{Binding Diagnostics.CopyLogCommand}" />
                                <Button Content="清空" Style="{StaticResource SubtleButtonStyle}"
                                        Command="{Binding Diagnostics.ClearLogCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource InsetCardStyle}" Padding="4">
                            <ListView ItemsSource="{Binding Diagnostics.Log.Entries}" Height="326"
                                      SelectionMode="None"
                                      IsItemClickEnabled="False">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="8,3" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="3" VerticalAlignment="Stretch" Margin="0,3">
                                                <Border Background="{ThemeResource StatusIdleBrush}" CornerRadius="2" />
                                                <Border Background="{ThemeResource StatusSuccessBrush}" CornerRadius="2"
                                                        Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}" />
                                                <Border Background="{ThemeResource StatusWarningBrush}" CornerRadius="2"
                                                        Visibility="{Binding IsWarning, Converter={StaticResource BoolToVisibility}}" />
                                                <Border Background="{ThemeResource StatusDangerBrush}" CornerRadius="2"
                                                        Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>

                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="11.5"
                                                       VerticalAlignment="Top" Margin="0,2,0,0"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12.5"
                                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,1,0,1" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
